DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Cheapest model. deepseek-v4-flash (cheap/fast) or deepseek-v4-pro (smarter).
DEEPSEEK_MODEL=deepseek-v4-flash
PORT=3005
# Total concurrent workers, spread evenly across the browser pool.
BATCH_SIZE=60
# Number of separate browser processes. Workers are distributed round-robin,
# so BATCH_SIZE=30 with BROWSER_POOL=3 = 10 concurrent tabs per browser.
BROWSER_POOL=3
# Block images/css/fonts/video while scraping (we only read text/HTML/schema).
# Massively reduces bandwidth + timeouts. Set to 0 to load full pages.
BLOCK_RESOURCES=1
# Delay (ms) * worker index before each worker's first request, so workers
# don't all fire page loads at the same instant. 0 disables.
STAGGER_MS=150
# Max simultaneous DeepSeek API calls. Set equal to BATCH_SIZE so the AI step
# never bottlenecks the scrapers (DeepSeek imposes no hard rate limit). Lower it
# only if you start seeing ai:...429 / ai:...503 in ScrapeStatus.
AI_CONCURRENCY=60
# Retries on 429/503 rate-limit responses, with exponential backoff.
AI_MAX_RETRIES=4

# How many full passes to attempt (initial + retries). Failed rows from each
# pass are reprocessed after a cooldown until either all succeed or we run out
# of passes. Default 3 = initial + 2 retries.
RETRY_PASSES=3
# Milliseconds to wait between passes — gives slow/flaky sites time to recover.
RETRY_COOLDOWN_MS=45000

# === Proxy (optional) ===
# Route every scrape through a proxy so target sites see a different IP per
# request. Useful when you hit "Too many requests" / 429s / Cloudflare bans.
# Set PROXY_SERVER to enable; leave blank to disable.
# For Webshare rotating residential: PROXY_SERVER=http://p.webshare.io:80
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Optional comma-separated bypass list, e.g. "localhost,127.0.0.1"
PROXY_BYPASS=
# 0 = ALL requests through proxy (new rotating IP per scrape). Recommended when
#     target sites block/throttle hard. 1 = direct first, proxy only on retry.
PROXY_ON_RETRY_ONLY=0
# Attempts per URL within a pass (escalating timeouts 30s/45s/60s/60s/60s).
# Each attempt opens a fresh context, so the rotating proxy hands it a new IP.
SCRAPE_ATTEMPTS=5
