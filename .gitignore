# Dependencies
node_modules/

# Secrets & local config (contains API key + proxy password)
.env
.env.local

# Runtime data — ignore everything in these dirs except the .gitkeep placeholder
jobs/*
output/*
uploads/*
!jobs/.gitkeep
!output/.gitkeep
!uploads/.gitkeep

# Logs & OS junk
*.log
.DS_Store
Thumbs.db
desktop.ini
