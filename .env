DEEPSEEK_API_KEY=sk-f2cc8cf5ef954380b244ff36370eca3b
# Cheapest DeepSeek model. Options:
#   deepseek-v4-flash  - cheapest, fast (recommended)
#   deepseek-v4-pro    - higher quality, more expensive
#   deepseek-chat      - deprecated 2026/07/24 (maps to v4-flash non-thinking)
DEEPSEEK_MODEL=deepseek-v4-flash

PORT=3006
# Total concurrent workers across all browsers.
BATCH_SIZE=30
# Number of separate browser processes. 30 workers / 3 browsers = 10 tabs each.
BROWSER_POOL=3
# Block images/css/fonts/video while scraping.
BLOCK_RESOURCES=1
# Delay (ms) * worker index before each worker's first request.
STAGGER_MS=150
# Attempts per URL within a pass (escalating timeouts 30s/45s/60s).
SCRAPE_ATTEMPTS=3
RETRY_PASSES=3
RETRY_COOLDOWN_MS=45000

# === Rotating proxy (Webshare) ===
PROXY_SERVER=http://p.webshare.io:80
PROXY_USERNAME=krazblud-US-rotate
PROXY_PASSWORD=ithigl5ggoda
PROXY_BYPASS=
# 1 = direct first, proxy only on retry. 0 = always proxy.
PROXY_ON_RETRY_ONLY=1

# Max simultaneous DeepSeek API calls.
AI_CONCURRENCY=60
# Retries on 429/503, with exponential backoff.
AI_MAX_RETRIES=4
